# =============================================================================
# Copy to .env on VPS:  cp .env.example .env && nano .env
# Path: /opt/tobe-prod  (Postgres/uploads/certs/logs stay under /opt/tobe-prod/data and /opt/tobe-prod/logs)
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=LanguageInstituteDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# ─── Administration tools (docker-compose.tools.yml) ───────────────────────
# These UIs bind to localhost; access them through an SSH tunnel.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-pgadmin-password
PGADMIN_PORT=5050
PORTAINER_PORT=9443

# ─── JWT / seed (JWT_KEY must be >= 32 chars) ───────────────────────────────
JWT_KEY=LanguageInstituteProdJwtKey_ChangeMe_AtLeast32Chars!
Jwt__Issuer=LanguageInstitute
Jwt__Audience=LanguageInstituteUsers
SEED_ADMIN_PASSWORD=ChangeMe!123
# Production refuses ChangeMe!123 unless this is true (demo / first boot).
Seed__AllowDefaultPasswordInProduction=true
Swagger__Enabled=false

# ─── Docker Hub images (SHA from tobe-dev CI — never :latest) ───────────────
DOCKER_USERNAME=your-dockerhub-user
FRONTEND_IMAGE_TAG=replace-with-sha
BACKEND_IMAGE_TAG=replace-with-sha

# ─── Public site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hamidrezafallahi.ir
NEXT_PUBLIC_SITE_NAME=کالج زبان tobe
DOMAIN_NAME=hamidrezafallahi.ir
SERVER_IP=188.240.196.165
CERTBOT_EMAIL=hamidreza.lipar@gmail.com
NGINX_PORT=80
NGINX_SSL_PORT=443
BACKEND_PORT=8080
COMPOSE_PROJECT_NAME=institute

# ─── TURN / WebRTC (P069) — REQUIRED for classroom AV behind NAT ─────────────
# TURN_EXTERNAL_IP = this VPS public IPv4 (curl -4 ifconfig.me)
TURN_EXTERNAL_IP=188.240.196.165
TURN_USERNAME=institute
TURN_CREDENTIAL=replace-with-long-random-turn-secret
TURN_REALM=institute.local
WebRtc__Turn__Urls=turn:188.240.196.165:3478
WebRtc__Turn__Username=institute
WebRtc__Turn__Credential=replace-with-long-random-turn-secret

# ─── SMTP (optional for demo; enable for session/debt reminders) ─────────────
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__UseSsl=true
Smtp__FromAddress=noreply@hamidrezafallahi.ir
Smtp__FromName=کالج زبان tobe
Smtp__SiteUrl=https://hamidrezafallahi.ir
Smtp__Username=
Smtp__Password=

# ─── Institute brand (PDFs / email) — change here to rebrand ─────────────────
Institute__DisplayName=کالج زبان tobe

# ─── Institute policy flags (restart backend after change) ───────────────────
Billing__ActivateOnPay=false
Billing__OnlineGatewayEnabled=false
Certificates__MinAttendancePercent=80
Certificates__MinFinalPercent=70
RateLimiting__Enabled=true
